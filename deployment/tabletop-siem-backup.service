[Unit]
Description=Back up Tabletop SIEM exercise state

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tabletop-siem
EnvironmentFile=-/etc/tabletop-siem.env
ExecStart=/home/ubuntu/tabletop-siem/.venv/bin/python deployment/backup_state.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
